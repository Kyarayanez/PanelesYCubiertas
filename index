function shapeOf(poly){const s=new THREE.Shape();poly.forEach(([x,y],i)=>i?s.lineTo(x,y):s.moveTo(x,y));s.closePath();return s}
function extrude(poly,mat,cx){
  const g=new THREE.ExtrudeGeometry(shapeOf(poly),{depth:L,bevelEnabled:false,curveSegments:1});
  g.translate(-cx,0,-L);
