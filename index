  const foam=up.concat([[xm,HD],[xm-HN,HD],[xm-HN,0],[xc+HN,0],[xc+HN,HD],[xc,HD]]);
  const sh=[[Xj+HW/2-(PW+GAP),0],[Xj-HW/2,0]];
  let polys=[[foam,foamMat],[strip(up,Fm.c),sheetMat(Fm.f)],[strip(sh,-Fp.c),sheetMat(Fp.f)]];
  if(ip===0)polys=polys.map(([p,m])=>[mirror(p),m]);   /* PRFV arriba: se voltea el corte */
  polys.forEach(([p,m],k)=>{const o=extrude(p,m,PW/2);if(k)o.receiveShadow=false;group.add(o);});
  JX1=PW+GAP; JJ=Xj-PW/2;
}
function buildPanelStraight(group){
  JX1=PW+HG; JJ=(PW+HG)/2;
  const [F1,F2]=faces(), a=facePaths(F1), b=facePaths(F2);
  group.add(extrude(a.foam.concat(mirror(b.foam).reverse()),foamMat,PW/2));
  const s1=extrude(strip(a.sheet,F1.c),sheetMat(F1.f),PW/2), s2=extrude(strip(mirror(b.sheet),-F2.c),sheetMat(F2.f),PW/2);
  s1.receiveShadow=false; s2.receiveShadow=false; group.add(s1); group.add(s2);
