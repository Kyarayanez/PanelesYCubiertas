/* Perfil H (corte): tapa ancha por fuera, alma central entre las dos láminas y ala inferior que las sujeta por debajo */
function hPoly(c){
  const w=HW/2,B=OV+w-.4,A=19,tc=1.4,tf=1.2,y=T-.05,yc=T+c+.05;
  return[[-w,y],[-B,y],[-B,y-tf],[B,y-tf],[B,y],[w,y],[w,yc],[A,yc],[A-.6,yc+tc*.7],[A-4,yc+tc],[-A+4,yc+tc],[-A+.6,yc+tc*.7],[-A,yc],[-w,yc]];
}
function buildH(){
  hgrp.children.forEach(o=>o.geometry.dispose()); hgrp.clear();
  if(!straight())return;
  faces().forEach((F,i)=>{if(F.f!=='prfv')return;const m=extrude(i?mirror(hPoly(F.c)):hPoly(F.c),hMat,0);m.receiveShadow=false;hgrp.add(m);});
}
function buildPanel(group){
  if(prfvBoth())return buildPanelStraight(group);
  if(straight())return buildPanelMixed(group);
  const [F1,F2]=faces();
  const fem=femaleTop(), male=maleTop(), run=panelTopRun(F1.f), run2=panelTopRun(F2.f);
  const R=n=>Object.assign([],{[fem.length-1]:jface(),[fem.length+n]:jface()});
  const up=fillet(fem.concat(run,male),R(run.length));
  const lo=fillet(fem.concat(run2,male),R(run2.length));   /* cara inferior con su propio tableteado */
  /* Centro curvo y sutil: el del macho sobresale en arco y el de la hembra se hunde con el mismo arco. */
  const sag=-Math.min(1,.2*jc());
  const arc=(P,Q)=>{const o=[];for(let k=1;k<16;k++){const t=k/16;o.push([P[0]+(Q[0]-P[0])*t-sag*Math.sin(Math.PI*t),P[1]+(Q[1]-P[1])*t]);}return o;};
  const dn=mirror(lo).reverse();
  const foam=up.concat(arc(up[up.length-1],dn[0]),dn,arc(dn[dn.length-1],up[0]));
  group.add(extrude(foam,foamMat,PW/2));
