    <h2 id="specTitle">${S.title}</h2>
    <p class="desc">${S.desc}</p>
    <p class="note">${inCat?`Resaltado: el espesor que tienes seleccionado (${T} mm).`:`El espesor seleccionado (${T} mm) no está en la ficha; los espesores de catálogo son ${S.t.join(', ')} mm.`}</p>
    <div class="grid2">${coreBlock(S,'pur')}</div>
    <section><h2>Acabados</h2><div class="finishes">${S.finishes.map(([a,b])=>`<div class="finish"><b>${a}</b><span>${b}</span></div>`).join('')}</div></section>`;
  document.getElementById('specBox').hidden=false;
  document.getElementById('specClose').focus();
}
document.getElementById('specBtn').onclick=openSpec;
document.getElementById('specClose').onclick=()=>{document.getElementById('specBox').hidden=true;document.getElementById('specBtn').focus();};
document.getElementById('specBox').addEventListener('click',e=>{if(e.target.id==='specBox')document.getElementById('specClose').click();});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!document.getElementById('specBox').hidden)document.getElementById('specClose').click();});

/* Imagen de catálogo con la diagramación del manual: banda azul con curva, web abajo a la izquierda, logotipo abajo a la derecha */
function brandShot(src){
  const W=src.width,H=src.height,BH=Math.round(W*.07),CH=Math.round(BH*.55);
  const c=document.createElement('canvas');c.width=W;c.height=H+BH;const g=c.getContext('2d');
  g.drawImage(src,0,0);
  g.fillStyle='#0077C8';g.fillRect(0,H,W,BH);
  const cw=CH*4.2;g.beginPath();g.moveTo(0,H-CH);g.bezierCurveTo(cw*.18,H-CH,cw*.32,H-CH*.5,cw*.46,H-CH*.2);
  g.bezierCurveTo(cw*.6,H,cw*.75,H,cw,H);g.lineTo(0,H);g.closePath();g.fill();
  const pad=Math.round(W*.04);
  g.fillStyle='#fff';g.font=`400 ${Math.round(BH*.2)}px Roboto, Arial, sans-serif`;g.textBaseline='middle';
  g.fillText('www.mafrico.com',pad,H+BH/2);
  const lh=Math.round(BH*.26);g.fillStyle='#fff';drawWordmark(g,W-pad-lh*WORD_W/2,H+BH/2,lh);
  return c.toDataURL('image/png');
}
function paintLogo(id,color,h){
  const c=document.getElementById(id);if(!c)return;
  c.height=Math.ceil(h)+4;c.width=Math.ceil(h*WORD_W)+4;
  const g=c.getContext('2d');g.clearRect(0,0,c.width,c.height);g.fillStyle=color;drawWordmark(g,c.width/2,c.height/2,h);
}
paintLogo('brandLogo','#fff',44);
paintLogo('bandLogo','#fff',36);

renderControls(); build(); resize(); setView('cat');
document.getElementById('joinBtn').onclick=()=>{
  joinTarget=joinTarget?0:1;
  document.getElementById('joinBtn').textContent=joinTarget?'Separar':(product==='roof'?'Traslape':'Encaje');
};
document.getElementById('prfvSim').onclick=()=>{
  setView('union'); joinTarget=1; document.getElementById('joinBtn').textContent='Separar';
  document.getElementById('view').scrollIntoView({behavior:'smooth',block:'center'});
};
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
document.getElementById('flipBtn').onclick=()=>{flipTarget=flipTarget?0:1;renderControls();applyView(curView);};
(function loop(){
  if(flipT!==flipTarget){flipT=reduce?flipTarget:flipT+Math.sign(flipTarget-flipT)*Math.min(.025,Math.abs(flipTarget-flipT));placeRig();}
  if(join!==joinTarget){join=reduce?joinTarget:join+Math.sign(joinTarget-join)*Math.min(.02,Math.abs(joinTarget-join));place2();}
  controls.update();renderer.render(scene,cam);requestAnimationFrame(loop)})();
</script>

