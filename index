/* ---------- utilidades de perfil (mm). x: ancho, y: espesor, extruido a lo largo ---------- */
function mirror(p){return p.map(([x,y])=>[x,T-y])}
function strip(pts,t){
  const out=[],inn=[];
  for(let i=0;i<pts.length;i++){
    const a=pts[Math.max(0,i-1)],b=pts[i],c=pts[Math.min(pts.length-1,i+1)];
    let n1=[-(b[1]-a[1]),b[0]-a[0]],n2=[-(c[1]-b[1]),c[0]-b[0]];
    const nl=v=>{const l=Math.hypot(v[0],v[1])||1;return[v[0]/l,v[1]/l]};
    n1=i===0?nl(n2):nl(n1);n2=i===pts.length-1?n1:nl(n2);
    let n=nl([n1[0]+n2[0],n1[1]+n2[1]]);const d=Math.max(.5,n[0]*n1[0]+n[1]*n1[1]);
    out.push([b[0]+n[0]*t/d,b[1]+n[1]*t/d]);inn.push(b);
