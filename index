  const t=new THREE.CanvasTexture(c);t.wrapS=THREE.RepeatWrapping;t.encoding=THREE.sRGBEncoding;t.anisotropy=MAXANI;return t;
}
function tapeMat(){return new THREE.MeshStandardMaterial({roughness:.45,metalness:0,side:THREE.DoubleSide});}
/* Cinta sobre una cara lateral (puede ser inclinada): de (x1,y1) abajo a (x2,y2) arriba, a lo largo de todo el panel.
   side=-1: cara que mira a la izquierda; side=+1: cara que mira a la derecha. */
function tapeSeg(mat,x1,y1,x2,y2,side){
  const dx=x2-x1,dy=y2-y1,len=Math.hypot(dx,dy);
  const nx=side<0?-dy/len:dy/len, ny=side<0?dx/len:-dx/len, o=.4;
  const ax=x1+nx*o, ay=y1+ny*o, bx=x2+nx*o, by=y2+ny*o;
  const g=new THREE.BufferGeometry();
  const us=side<0?-1:1, U=L/TAPE_TILE;
  g.setAttribute('position',new THREE.Float32BufferAttribute([ax,ay,0, bx,by,0, ax,ay,-L, bx,by,-L],3));
  g.setAttribute('uv',new THREE.Float32BufferAttribute([0,0, 0,1, us*U,0, us*U,1],2));
  g.setIndex([0,2,1, 1,2,3]);g.computeVertexNormals();
  const t=tapeTex(len);const m=new THREE.Mesh(g,mat.clone());m.material.map=t;m.receiveShadow=true;return m;
}
if(document.fonts&&document.fonts.load)document.fonts.load('700 80px Archivo').then(()=>{if(product==="roof"){build();setView(curView);}}).catch(()=>{});

let panel=null, panel2=null, showUnion=false, join=0, joinTarget=0;
/* rig: gira el panel 180° sobre su eje largo para ver la otra cara */
const rig=new THREE.Group(), inner=new THREE.Group(), hgrp=new THREE.Group();rig.add(inner);inner.add(hgrp);scene.add(rig);
const hTot=()=>product==="panel"?T:T+RH;
function placeRig(){
  const e=flipT*flipT*(3-2*flipT), H=hTot();
  inner.position.y=-H/2;
  rig.rotation.z=Math.PI*e;
  rig.position.y=H/2+Math.sin(Math.PI*e)*(H*.5+60);
}
/* Posición del segundo panel: separado (j=0) o encajado (j=1). */
function place2(){
  if(!panel2)return;
  const e=join*join*(3-2*join);
  if(product==="panel"&&straight()){
    /* 1) el perfil H se desliza sobre el borde del primer panel; 2) el segundo panel entra en la otra ranura */
    const s=v=>v*v*(3-2*v),a=s(Math.min(1,join*2)),b=s(Math.max(0,join*2-1));
    hgrp.position.set(JJ+70*(1-a),0,0); panel2.position.set(JX1+150*(1-b),0,0);
  }
  else if(product==="panel"){const x0=PW+GAP+40,x1=PW+GAP;panel2.position.set(x0+(x1-x0)*e,0,0);}
  else{panel2.position.set(RW+45*(1-e),70*(1-e)*(1-e),0);}
}
function build(){
  if(panel){inner.remove(panel,panel2);panel.traverse(o=>{if(o.geometry)o.geometry.dispose()})}
  panel=new THREE.Group();
  if(product==="panel") buildPanel(panel); else buildRoof(panel);
  panel2=panel.clone();
  buildH();
  place2();
  panel2.visible=showUnion; hgrp.visible=showUnion;
  inner.add(panel,panel2);placeRig();
  const P=PRODUCTS[product],[F1,F2]=faces(),cal=c=>c.toFixed(2).replace('.',',')+' mm';
  document.getElementById('ttl').textContent=P.name;
  document.getElementById('spec').textContent=`${P.faces[0].short}: ${FIN[F1.f].short} ${cal(F1.c)} · ${P.faces[1].short}: ${FIN[F2.f].short} ${cal(F2.c)} · ${P.spec(T)}`;
}

function VIEWS(k){
  if(product==="panel"){const H=PW/2;return{
    cat:[[260,330,950],[60,0,-520]],
    cut:[[0,160,1250],[0,T/2,-200]],
    macho:[[H+T*.8,T*1.3,T*3.5],[H+T*.05,T/2,0]],
    hembra:[[-H-T*.8,T*1.3,T*3.5],[-H-T*.05,T/2,0]],
    union:[[H+20,T/2,T*40+800],[H+20,T/2,0],6]}[k]}
  const H=RW/2,y=(T+RH)/2;return{
    cat:[[220,380,1000],[40,0,-520]],
    cut:[[0,200,1300],[0,y,-200]],
    traslape:[[H+60,T+RH+80,320],[H-15,y+10,0]],
    union:[[H,420,1500],[H,y,-300]]}[k];
}
function setView(k){
  curView=k; showUnion=(k==="union"||k==="traslape");
  if(panel2)panel2.visible=showUnion; hgrp.visible=showUnion;
  join=0; joinTarget=0; place2();
  document.getElementById('joinGroup').hidden=!showUnion;
  document.getElementById('joinBtn').textContent=product==='roof'?'Traslape':'Encaje';
  applyView(k);
}
/* Al voltear el panel (giro de 180° sobre su eje largo) los extremos cambian de lado:
   la cámara se refleja en x para seguir mirando el mismo machihembrado o traslape. */
function applyView(k){
  const[p,t,f]=VIEWS(k), m=flipTarget?-1:1;
  cam.fov=f||30;cam.updateProjectionMatrix();
  cam.position.set(p[0]*m,p[1],p[2]);controls.target.set(t[0]*m,t[1],t[2]);controls.update();
}

/* ---------- controles ---------- */
function btns(id,items,cur,cb){
  const el=document.getElementById(id);el.innerHTML="";
  for(const[k,lab]of items){
    const b=document.createElement('button');b.textContent=lab;b.id=id+'-'+k;
    if(cur!==null)b.setAttribute('aria-pressed',String(k===cur));
    b.onclick=()=>cb(k);el.appendChild(b);
  }
}
function renderControls(){
  const P=PRODUCTS[product];
  const box=document.getElementById('fin');box.innerHTML='';
  document.getElementById('custLabel').textContent='Personaliza tu '+P.what;
  P.faces.forEach((fd,i)=>{
    const F=faces()[i],row=document.createElement('div');row.className='face';
    const lab=document.createElement('label');lab.textContent=fd.lab;lab.htmlFor='face'+i+'-fin';
    const sf=document.createElement('select');sf.id='face'+i+'-fin';
    fd.opts.forEach(k=>sf.add(new Option(FIN[k].lab,k,false,k===F.f)));
    const sc=document.createElement('select');sc.id='face'+i+'-cal';sc.setAttribute('aria-label','Calibre de '+fd.lab);
    const fillCal=()=>{sc.innerHTML='';const cs=FIN[F.f].cal;if(!cs.includes(F.c))F.c=cs.includes(.5)?.5:cs[0];
      cs.forEach(c=>sc.add(new Option((F.f==='prfv'?'Espesor ':'Calibre ')+c.toFixed(2)+' mm',c,false,c===F.c)));sc.disabled=cs.length<2;};
    fillCal();
    sf.onchange=()=>{F.f=sf.value;fillCal();build();updateMode();};
    sc.onchange=()=>{F.c=+sc.value;build();};
    row.append(lab,sf,sc);box.appendChild(row);
  });
  const fb=document.getElementById('flipBtn');
  fb.textContent=flipTarget?('Ver '+P.faces[0].short.toLowerCase()):('Ver '+(product==='panel'?'cara ':'lámina ')+P.faces[1].short.toLowerCase());
  const th=document.getElementById('thk'); th.innerHTML='';
  const TL=P.thick, mn=TL[0], mx=TL[TL.length-1];
  if(!TL.includes(T)){T=TL.reduce((a,b)=>Math.abs(b-T)<Math.abs(a-T)?b:a);sel[product].t=T;}
  const rg=document.createElement('input'); rg.type='range'; rg.id='thk-range'; rg.min=0; rg.max=TL.length-1; rg.step=1; rg.value=TL.indexOf(T);
  rg.setAttribute('aria-label','Espesor en mm');
  const out=document.createElement('output'); out.id='thk-out'; out.textContent=T+' mm';
  const ends=document.createElement('span'); ends.className='range-ends'; ends.textContent=`${mn}–${mx} mm`;
  rg.setAttribute('aria-valuetext',T+' mm');
  rg.oninput=()=>{T=TL[+rg.value]; sel[product].t=T; out.textContent=T+' mm'; rg.setAttribute('aria-valuetext',T+' mm'); build();};
  rg.onchange=()=>setView(curView);
  th.append(rg,out,ends);
  updateMode(true);
}
/* Vistas y aviso según el tipo de unión (con PRFV no hay macho/hembra: la unión es con perfil H) */
function updateMode(quiet){
  const P=PRODUCTS[product], st=straight();
  let v=Object.entries(P.views);
  if(st)v=v.filter(([k])=>!prfvBoth()||(k!=='macho'&&k!=='hembra')).map(([k,l])=>[k,k==='union'?'Unión con perfil H':l]);
  btns('vw',v,null,k=>setView(k));
  document.getElementById('prfvNote').hidden=!st;
  if(!quiet)setView(prfvBoth()&&(curView==='macho'||curView==='hembra')?'cat':curView);
}
document.querySelectorAll('[data-p]').forEach(tab=>tab.onclick=()=>{
  product=tab.dataset.p; T=sel[product].t; flipT=flipTarget=0;
  document.querySelectorAll('[data-p]').forEach(x=>x.setAttribute('aria-selected',String(x===tab)));
  renderControls(); build(); setView('cat');
});

function resize(){const r=view.getBoundingClientRect();renderer.setSize(r.width,r.height,false);cam.aspect=r.width/r.height;cam.updateProjectionMatrix()}
new ResizeObserver(resize).observe(view);

document.getElementById('shot').onclick=()=>{
  const prevBg=scene.background.clone(), prevOp=ground.material.opacity, prevU=panel2.visible;
  const pp=cam.position.clone(), pt=controls.target.clone(), pa=cam.aspect, pf=cam.fov;
  const r=view.getBoundingClientRect();
  panel2.visible=false; const prevHv=hgrp.visible; hgrp.visible=false;
  /* acabados blancos (lámina RAL 9010 y PRFV) sobre gris medio Cool Gray 6 C; aceros y galvanizado sobre blanco */
  const vis=faces()[flipTarget?1:0].f, blanco=['ral','prfv','ralr'].includes(vis);
  scene.background=new THREE.Color(blanco?0xA7A8AA:0xFFFFFF); ground.material.opacity=blanco?.32:.22;
  renderer.setPixelRatio(1); renderer.setSize(2400,1080,false);
  cam.aspect=2400/1080; cam.fov=24;
  if(product==="panel") cam.position.set(0,560,2550); else cam.position.set(0,640,2600);
  controls.target.set(0,-10,-480);
  cam.lookAt(controls.target); cam.updateProjectionMatrix();
  renderer.render(scene,cam);
  document.getElementById('shotImg').src=brandShot(renderer.domElement);
  scene.background=prevBg; ground.material.opacity=prevOp; panel2.visible=prevU; hgrp.visible=prevHv;
  renderer.setPixelRatio(Math.min(devicePixelRatio,2)); renderer.setSize(r.width,r.height,false);
  cam.aspect=pa; cam.fov=pf; cam.position.copy(pp); controls.target.copy(pt); cam.updateProjectionMatrix();
  document.getElementById('shotBox').hidden=false;
};
document.getElementById('shotClose').onclick=()=>document.getElementById('shotBox').hidden=true;

/* ---------- Fichas técnicas 2024 (MAFRIWALL = panel de pared, MAFRITECH = cubierta) ---------- */
const SPECS={
