    desc:'Panel sándwich autoportante con núcleo de poliuretano (PUR) inyectado de 40 kg/m³ y conductividad térmica de 0,021 W/m·K, revestido por ambas caras con lámina metálica o PRFV. Unión longitudinal machihembrada. Aplicación: fachadas, cerramientos, techos y revestimiento de cámaras frigoríficas y ambientes de atmósfera controlada. Espesores de 40 a 125 mm; ancho útil de 1000 o 1160 mm.',
    t:[40,50,60,80,100,125],
    pur:{peso:[9.08,9.56,10.04,10.99,11.94,13.13],apoyo:[2.50,2.70,3.00,3.50,3.80,4.10],dens:'40 kg/m³'},
    pir:{peso:[9.23,9.74,10.25,11.28,12.30,13.59],apoyo:[2.50,2.70,3.00,3.50,3.80,4.10],dens:'42 kg/m³'},
    ancho:'1000 mm y 1160 mm',
    finishes:[['Lámina prepintada blanca','Lámina de acero galvanizado prepintado blanco, RAL 9010. Calibre 0.40 · 0.45 · 0.50 · 0.60 mm.'],
              ['Acero inoxidable','Lámina de acero inoxidable AISI 430 o AISI 304. Calibre 0.50 mm.'],
              ['PRFV','Lámina de resinas de poliéster reforzada con fibra de vidrio, 2.00 mm de espesor, color blanco RAL 9010.']]},
  roof:{name:'TECH',title:'Ficha técnica MAFRITECH',
    desc:'Panel sándwich para cubiertas con núcleo de poliuretano (PUR) inyectado de 40 kg/m³ y conductividad térmica de 0,021 W/m·K. Cara exterior en lámina trapezoidal de acero galvanizado, natural o prepintado RAL 9010. Unión longitudinal por traslape. Espesores de 30 a 125 mm; ancho útil de 1000 mm.',
    t:[30,40,50,60,80,100,125],
    pur:{peso:[9.00,9.60,10.20,10.80,12.00,13.15,14.60],apoyo:[3.10,3.30,3.50,3.70,4.00,4.00,4.00],dens:'40 kg/m³'},
    pir:{peso:[9.05,9.70,10.30,10.90,12.10,13.30,14.80],apoyo:[3.10,3.30,3.50,3.70,4.00,4.00,4.00],dens:'42 kg/m³'},
    ancho:'1000 mm',
    finishes:[['Lámina prepintada blanca','Lámina de acero galvanizado prepintado blanco, RAL 9010. Calibre 0.40 · 0.45 · 0.50 · 0.60 mm.'],
              ['Acero galvanizado natural','Lámina de acero galvanizado natural. Calibre 0.40 · 0.45 · 0.50 · 0.60 mm.']]}
};
const CORE={
  pur:{label:'PUR · Poliuretano',comp:'120 kPa mínimo',cond:'0,021 W/m·K',fuego:'Contiene retardantes a la llama; clasificado como R3 o NR.'},
  pir:{label:'PIR · Poliisocianurato',comp:'120 kPa mínimo',cond:'0,021 W/m·K',fuego:'Contiene en su formulación agentes retardantes a la llama; clasificado como R1.'}
};
const f2=v=>v.toFixed(2);
function coreBlock(S,key){
  const d=S[key],C=CORE[key];
  const th=S.t.map(t=>`<th class="${t===T?'on':''}">${t}</th>`).join('');
  const row=(lab,arr,fmt)=>`<tr><td>${lab}</td>${arr.map((v,i)=>`<td class="${S.t[i]===T?'on':''}">${fmt(v)}</td>`).join('')}</tr>`;
  return `<section><h3>${C.label}</h3>
    <div class="tbl"><table><thead><tr><th>Espesor [mm]</th>${th}</tr></thead><tbody>
      ${row('Peso [kg]',d.peso,f2)}${row('Separación entre apoyos [m]',d.apoyo,f2)}
    </tbody></table></div>
    <dl class="kv" style="margin-top:10px">
      <dt>Densidad</dt><dd>${d.dens}</dd>
      <dt>Ancho útil</dt><dd>${S.ancho}</dd>
      <dt>Resistencia a la compresión</dt><dd>${C.comp}</dd>
      <dt>Conductividad térmica</dt><dd>${C.cond}</dd>
      <dt>Resistencia al fuego</dt><dd>${C.fuego}</dd>
    </dl></section>`;
}
function openSpec(){
  const S=SPECS[product];
  const lc=document.getElementById('specLogo'),h=30,g=lc.getContext('2d');
  /* submarca: “MAFRI” con las letras del logotipo + nombre del producto en la tipografía corporativa */
  const mw=Math.ceil(h/LOGO_H*MAFRI_W)+4;
  g.font=`500 ${h*1.12}px Rektorat, Saira, Arial, sans-serif`;
  const tw=Math.ceil(g.measureText(S.name).width);
  lc.width=mw+tw+10;lc.height=h+8;lc.style.height='30px';
  g.clearRect(0,0,lc.width,lc.height);g.fillStyle='#fff';drawWordmark(g,mw/2,lc.height/2,h,5);
  g.font=`500 ${h*1.12}px Rektorat, Saira, Arial, sans-serif`;g.textBaseline='middle';g.fillStyle='#fff';g.fillText(S.name,mw+4,lc.height/2+1);
  lc.setAttribute('aria-label','MAFRI'+S.name);
  paintLogo('specBy','#fff',12);document.getElementById('specBy').style.height='12px';
  const inCat=S.t.includes(T);
