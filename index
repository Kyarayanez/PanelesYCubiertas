<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Panel Sándwich Mafrico</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Saira:wght@500;600;700;800&family=Roboto:wght@300;400;500;700&display=swap">
<style>
/* Diseño según el Manual de Marca MAFRICO:
   · Colores corporativos: Pantone 3005 C (azul), Cool Gray 6 C, Cool Gray 1 C, 877 C (metálico) y Black C.
   · Tipografía: Rektorat para títulos y textos destacados (se usa Saira como sustituta web, misma construcción cuadrada),
     Roboto para cuerpos de texto.
   · Lenguaje visual: barra azul con el logotipo en blanco; banda inferior azul con curva, web abajo a la izquierda y
     logotipo abajo a la derecha.
   Diseño de un solo tema (claro), elegido a propósito para respetar la identidad. */
:root{
  --azul:#0077C8;        /* Pantone 3005 C */
  --gris6:#A7A8AA;       /* Pantone Cool Gray 6 C */
  --gris1:#D9D9D6;       /* Pantone Cool Gray 1 C */
  --metal:#8A8D8F;       /* Pantone 877 C (acabados especiales) */
  --negro:#2D2926;       /* Pantone Black C */
  --fondo:#F3F1EE;       /* fondo cálido de las piezas del manual */
  --blanco:#FFFFFF;
  --titulo:"Rektorat","Saira","Arial Narrow",Arial,sans-serif;
  --texto:"Roboto","Segoe UI",Arial,sans-serif;
  color-scheme:light;
}
html{height:100%}
body{min-height:100%;background:var(--fondo);color:var(--negro);font-family:var(--texto);display:flex;flex-direction:column;margin:0}
[hidden]{display:none!important}
.wrap{padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
/* barra superior de marca */
.topbar{background:var(--azul);color:var(--blanco)}
.topbar .wrap{display:flex;align-items:center;justify-content:space-between;gap:12px 24px;flex-wrap:wrap;padding-block:12px}
#brandLogo{height:22px;width:auto;display:block}
.tabs{display:flex;gap:4px}
.tabs button{border:0;border-radius:0;background:none;color:rgba(255,255,255,.75);font:700 .82rem var(--titulo);letter-spacing:.12em;text-transform:uppercase;padding:8px 12px;border-bottom:2px solid transparent;cursor:pointer}
.tabs button[aria-selected="true"]{color:var(--blanco);border-bottom-color:var(--blanco)}
.tabs button:focus-visible{outline:2px solid var(--blanco);outline-offset:2px}
main{flex:1;display:flex;flex-direction:column;gap:12px;padding-block:16px 18px;min-height:0}
header{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px}
h1{font:800 clamp(1.15rem,2.4vw,1.6rem)/1.1 var(--titulo);text-transform:uppercase;color:var(--azul);margin:0;text-wrap:balance;letter-spacing:.01em}
.spec{font:400 .82rem var(--texto);color:#6b6d6f}
#view{flex:1 1 auto;height:clamp(320px,62vh,760px);overflow:hidden;position:relative;background:var(--negro)}
#view canvas{display:block;width:100%;height:100%}
.hint{position:absolute;right:10px;bottom:8px;font:400 .72rem var(--texto);color:var(--gris1);background:rgba(45,41,38,.7);padding:3px 8px}
.controls{display:flex;flex-wrap:wrap;gap:12px 26px;align-items:center}
.group,.btns{display:flex;flex-wrap:wrap;align-items:center;gap:6px}
.label{font:700 .7rem var(--titulo);text-transform:uppercase;letter-spacing:.14em;color:var(--metal);margin-right:6px}
button{font:500 .84rem var(--texto);color:var(--negro);background:var(--blanco);border:1px solid var(--gris1);border-radius:2px;padding:7px 12px;cursor:pointer}
button:hover{border-color:var(--gris6)}
button[aria-pressed="true"]{background:var(--azul);border-color:var(--azul);color:var(--blanco)}
.primary{background:var(--azul);color:var(--blanco);border-color:var(--azul);font:700 .78rem var(--titulo);letter-spacing:.1em;text-transform:uppercase;padding:9px 14px}
.primary:hover{background:#005f9f;border-color:#005f9f}
button:focus-visible{outline:2px solid var(--azul);outline-offset:2px}
.custom{flex-basis:100%;align-items:flex-end;gap:10px 16px}
.custom>.label{flex-basis:100%}
.faces{display:flex;flex-wrap:wrap;gap:10px 18px}
.face{display:grid;grid-template-columns:auto auto;gap:4px 6px;align-items:center}
.face label{grid-column:1/-1;font:600 .74rem var(--texto);color:var(--negro)}
select{font:400 .84rem var(--texto);color:var(--negro);background:var(--blanco);border:1px solid var(--gris1);border-radius:2px;padding:7px 28px 7px 10px;max-width:100%;min-width:0;appearance:none;-webkit-appearance:none;
  background-image:linear-gradient(45deg,transparent 50%,#0077C8 50%),linear-gradient(135deg,#0077C8 50%,transparent 50%);background-position:calc(100% - 14px) 52%,calc(100% - 9px) 52%;background-size:5px 5px;background-repeat:no-repeat}
select:disabled{color:#6b6d6f;background-image:none;padding-right:10px}
select:focus-visible{outline:2px solid var(--azul);outline-offset:2px}
@media (max-width:520px){.face{grid-template-columns:1fr}.face select{width:100%}}
#thk-range{width:180px;max-width:50vw;accent-color:var(--azul)}
#thk-out{font:700 .85rem var(--titulo);min-width:4.5em;font-variant-numeric:tabular-nums;color:var(--azul)}
.range-ends{font-size:.72rem;color:#6b6d6f}
/* banda inferior de marca con la curva del lenguaje visual */
.band{position:relative;background:var(--azul);color:var(--blanco);margin-top:28px}
.band svg.curve{position:absolute;left:0;bottom:100%;width:120px;height:28px;display:block}
.band .wrap{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-block:14px calc(14px + env(safe-area-inset-bottom,0px))}
.band .web{font:400 .8rem var(--texto);letter-spacing:.02em}
#bandLogo{height:18px;width:auto;display:block}

.secondary{background:var(--blanco);color:var(--azul);border-color:var(--azul);font:700 .78rem var(--titulo);letter-spacing:.1em;text-transform:uppercase;padding:9px 14px}
.secondary:hover{background:#e8f1f9}
/* ficha técnica */
#specBox{position:fixed;inset:0;z-index:30;background:rgba(45,41,38,.72);display:flex;justify-content:center;align-items:flex-start;overflow-y:auto;padding:max(16px,env(safe-area-inset-top,0px)) max(16px,env(safe-area-inset-right,0px)) max(16px,env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px))}
.sheet{background:var(--blanco);width:min(960px,100%);margin-block:24px;box-shadow:0 20px 50px rgba(0,0,0,.3)}
.sheet-head{background:var(--azul);color:var(--blanco);display:flex;align-items:center;justify-content:space-between;gap:12px;padding:18px 24px;flex-wrap:wrap}
.sheet-head .prod{display:flex;align-items:center;gap:10px}
#specLogo{height:30px;width:auto;display:block}
.sheet-head .by{font:400 .72rem var(--texto);opacity:.9;display:flex;align-items:center;gap:8px}
#specBy{height:12px;width:auto}
.sheet-close{background:transparent;color:var(--blanco);border:1px solid rgba(255,255,255,.7);font:700 .72rem var(--titulo);letter-spacing:.1em;text-transform:uppercase}
.sheet-close:hover{background:rgba(255,255,255,.12)}
.sheet-body{padding:22px 24px 8px;display:flex;flex-direction:column;gap:22px}
.sheet-body p.desc{margin:0;font:300 1rem/1.55 var(--texto);max-width:70ch}
.sheet h2{font:800 1rem var(--titulo);text-transform:uppercase;letter-spacing:.06em;color:var(--azul);margin:0 0 10px}
.sheet h3{font:700 .8rem var(--titulo);text-transform:uppercase;letter-spacing:.1em;color:var(--negro);margin:0 0 8px}
.tbl{overflow-x:auto;border:1px solid var(--gris1)}
.tbl table{border-collapse:collapse;width:100%;min-width:560px;font:400 .85rem var(--texto);font-variant-numeric:tabular-nums}
.tbl th,.tbl td{padding:8px 10px;text-align:center;border-bottom:1px solid var(--gris1);white-space:nowrap}
.tbl th:first-child,.tbl td:first-child{text-align:left;color:#555;font-weight:500;position:sticky;left:0;background:var(--blanco)}
.tbl thead th{background:#f6f5f3;font:700 .78rem var(--titulo);letter-spacing:.06em;color:var(--negro)}
.tbl thead th:first-child{background:#f6f5f3}
.tbl .on{background:#e5f0f9;color:var(--azul);font-weight:700}
.tbl tr:last-child td{border-bottom:0}
.kv{display:grid;grid-template-columns:minmax(0,260px) minmax(0,1fr);gap:6px 16px;font:400 .88rem/1.45 var(--texto);margin:0}
.kv dt{color:#555;font-weight:500}.kv dd{margin:0}
.grid2{display:flex;flex-direction:column;gap:24px}
.finishes{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:12px}
.finish{border-top:3px solid var(--azul);background:#f6f5f3;padding:12px 14px}
.finish b{display:block;font:700 .82rem var(--titulo);letter-spacing:.04em;margin-bottom:4px}
.finish span{font:400 .84rem/1.45 var(--texto);color:#444}
.note{font:400 .76rem var(--texto);color:#6b6d6f;margin:0}
.sheet-foot{background:var(--negro);color:var(--gris1);display:flex;justify-content:space-between;align-items:center;gap:8px 20px;flex-wrap:wrap;padding:14px 24px;font:400 .8rem var(--texto);margin-top:14px}
.sheet-foot b{color:var(--blanco);font-weight:500}
@media (max-width:520px){.kv{grid-template-columns:1fr}.kv dt{margin-top:6px}}
.notice{flex:1 1 100%;display:flex;flex-wrap:wrap;align-items:center;gap:10px 16px;background:#eaf3fa;border-left:4px solid var(--azul);padding:10px 14px}
.notice p{margin:0;flex:1 1 260px;font:400 .86rem/1.45 var(--texto);color:#2D2926}
#shotBox{position:fixed;inset:0;background:rgba(45,41,38,.88);display:flex;align-items:center;justify-content:center;padding:max(16px,env(safe-area-inset-left,0px));z-index:20}
.shotInner{display:flex;flex-direction:column;gap:10px;max-width:100%}
#shotImg{max-width:100%;max-height:78vh}
.shotBar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;color:var(--blanco);font-size:.85rem}
</style>
</head>
<body>

<div class="topbar">
  <div class="wrap">
    <canvas id="brandLogo" width="320" height="44" role="img" aria-label="MAFRICO"></canvas>
    <nav class="tabs" role="tablist" aria-label="Producto">
      <button role="tab" id="tab-panel" data-p="panel" aria-selected="true">Paneles</button>
      <button role="tab" id="tab-roof" data-p="roof" aria-selected="false">Cubierta</button>
    </nav>
  </div>
</div>
<main class="wrap">
  <header>
    <h1 id="ttl">Panel sándwich de pared · RAL 9010 tableteado</h1>
    <span class="spec" id="spec"></span>
  </header>
  <div id="view"><span class="hint">Arrastra para girar en cualquier dirección (también por debajo) · rueda para acercar</span></div>
  <div class="controls">
    <div class="group custom" role="group" aria-labelledby="custLabel"><span class="label" id="custLabel">Personaliza tu panel</span><div class="faces" id="fin"></div><button id="flipBtn" class="secondary">Ver cara interior</button></div>
    <div class="group" role="group" aria-label="Espesor"><span class="label">Espesor</span><span class="btns" id="thk"></span></div>
    <div class="group" role="group" aria-label="Vista"><span class="label">Vista</span><span class="btns" id="vw"></span></div>
    <div class="group notice" id="prfvNote" hidden><p><b>Unión con PRFV:</b> Para la unión entre paneles con acabado en PRFV, se utiliza el <b>Perfil Barra División de PVC</b> (perfil H).</p><button id="prfvSim" class="secondary">Ver cómo se encaja</button></div>
    <div class="group" id="joinGroup" hidden><button id="joinBtn" class="primary">Encaje</button></div>
    <div class="group"><button id="specBtn" class="secondary">Ficha técnica</button><button id="shot" class="primary">Crear imagen de catálogo</button></div>
  </div>
</main>
<footer class="band">
  <svg class="curve" viewBox="0 0 120 28" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0 C 10 0 18 6 26 14 C 34 22 42 28 56 28 L 0 28 Z" fill="#0077C8"/></svg>
  <div class="wrap">
    <span class="web">www.mafrico.com</span>
    <canvas id="bandLogo" width="260" height="36" role="img" aria-label="MAFRICO"></canvas>
  </div>
</footer>
<div id="specBox" hidden role="dialog" aria-modal="true" aria-labelledby="specTitle">
  <article class="sheet">
    <div class="sheet-head">
      <div class="prod"><canvas id="specLogo" role="img"></canvas></div>
      <div class="by">Un producto de <canvas id="specBy" role="img" aria-label="MAFRICO"></canvas></div>
      <button class="sheet-close" id="specClose">Cerrar</button>
    </div>
    <div class="sheet-body" id="specBody"></div>
    <div class="sheet-foot"><span><b>MAFRICO</b> · Km. 16.5 Vía a Daule, Guayaquil, Ecuador</span><span>(593-4) 2162398-9 · 2162495 · 6002088-9</span></div>
  </article>
</div>
<div id="shotBox" hidden>
  <div class="shotInner">
    <img id="shotImg" alt="Imagen de catálogo">
    <div class="shotBar"><span>Clic derecho (o mantén presionado en el celular) sobre la imagen y elige “Guardar imagen”.</span><button id="shotClose">Cerrar</button></div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/three@0.147.0/build/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.147.0/examples/js/controls/OrbitControls.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.147.0/examples/js/environments/RoomEnvironment.js"></script>
<script>
const L=1500, SHEET=0.8, PW=1160, RW=1000, RH=40;
/* Acabados y calibres según las fichas técnicas 2024. tab = lámina con efecto tableteado. */
const FIN={
  ral: {lab:'Acero galvanizado prepintado blanco RAL 9010',short:'Prepintado blanco RAL 9010',cal:[.40,.45,.50,.60],tab:true},
  prfv:{lab:'PRFV (poliéster reforzado con fibra de vidrio) blanco RAL 9010',short:'PRFV blanco RAL 9010',cal:[2.00],tab:false},
  i304:{lab:'Acero inoxidable AISI 304',short:'Acero inox AISI 304',cal:[.50],tab:true},
  i430:{lab:'Acero inoxidable AISI 430',short:'Acero inox AISI 430',cal:[.50],tab:true},
  ralr:{lab:'Acero galvanizado prepintado blanco RAL 9010',short:'Prepintado blanco RAL 9010',cal:[.40,.45,.50,.60],tab:true},
  galv:{lab:'Acero galvanizado natural',short:'Galvanizado natural',cal:[.40,.45,.50,.60],tab:true}
};
const PRODUCTS={
  panel:{name:"Panel sándwich de pared MAFRIWALL",what:"panel",
    faces:[{lab:'Lámina 1 · cara exterior',short:'Exterior',opts:['ral','prfv','i304','i430']},
           {lab:'Lámina 2 · cara interior',short:'Interior',opts:['ral','prfv','i304','i430']}],
    thick:[40,50,60,70,80,90,100,125,150],   /* de 10 en 10 hasta 100 mm; después 125 y 150 mm */
    views:{cat:"Catálogo",cut:"Corte de frente",macho:"Macho",hembra:"Hembra",union:"Unión de 2 paneles"},
    spec:t=>`Núcleo PUR ${t} mm · ${prfvBoth()?'borde recto, unión con perfil H':straight()?'machihembrado + perfil H en la cara de PRFV':'machihembrado'} · 1160 mm útiles`},
  roof:{name:"Panel sándwich de cubierta MAFRITECH",what:"cubierta",
    faces:[{lab:'Lámina superior · ondulada',short:'Superior',opts:['ralr','galv']},
           {lab:'Lámina inferior · recta tableteada',short:'Inferior',opts:['ralr','galv']}],
    thick:[30,40,50,60,70,80,90,100,125],   /* de 10 en 10 hasta 100 mm; después 125 mm */
    views:{cat:"Catálogo",cut:"Corte de frente",traslape:"Traslape",union:"Unión de 2 cubiertas"},
    spec:t=>`Núcleo PUR ${t} mm + greca ${RH} mm · traslape · 1000 mm útiles`}
};
const sel={panel:{faces:[{f:'ral',c:.50},{f:'ral',c:.50}],t:50},roof:{faces:[{f:'galv',c:.50},{f:'ralr',c:.40}],t:40}};
let product="panel", T=50, curView="cat", flipT=0, flipTarget=0;
const faces=()=>sel[product].faces;

const view=document.getElementById('view');
/* logarithmicDepthBuffer: evita las rayitas por superficies muy juntas (cinta sobre poliuretano, lámina sobre núcleo) al acercarse */
const renderer=new THREE.WebGLRenderer({antialias:true,preserveDrawingBuffer:true,logarithmicDepthBuffer:true});
const MAXANI=renderer.capabilities.getMaxAnisotropy();
renderer.setPixelRatio(Math.min(devicePixelRatio,2));
renderer.outputEncoding=THREE.sRGBEncoding;
renderer.toneMapping=THREE.ACESFilmicToneMapping; renderer.toneMappingExposure=1.05;
renderer.shadowMap.enabled=true; renderer.shadowMap.type=THREE.PCFSoftShadowMap;
view.prepend(renderer.domElement);

const scene=new THREE.Scene();
scene.background=new THREE.Color(0x2D2926);   /* Pantone Black C */
const pm=new THREE.PMREMGenerator(renderer);
scene.environment=pm.fromScene(new THREE.RoomEnvironment(),0.04).texture;

const cam=new THREE.PerspectiveCamera(30,1,5,30000);
const controls=new THREE.OrbitControls(cam,renderer.domElement);
/* giro libre con el mouse o el dedo: se puede ir por encima y por debajo del panel para ver ambas caras */
controls.enableDamping=true; controls.minPolarAngle=0.01; controls.maxPolarAngle=Math.PI-0.01; controls.rotateSpeed=0.9;

scene.add(new THREE.HemisphereLight(0xffffff,0xd8d8d8,0.25));
/* luz suave desde abajo para que la cara inferior se vea bien al girar por debajo */
const under=new THREE.DirectionalLight(0xffffff,0.55);under.position.set(900,-1600,700);scene.add(under);
const sun=new THREE.DirectionalLight(0xffffff,1.35);
sun.position.set(-1700,1100,900); sun.castShadow=true;
sun.shadow.mapSize.set(4096,4096);
Object.assign(sun.shadow.camera,{left:-1600,right:1600,top:1600,bottom:-1600,near:100,far:5000});
/* bias + normalBias: quitan el “acné de sombra” (franjas que aparecen al hacer zoom) */
sun.shadow.bias=-0.0002; sun.shadow.normalBias=2.5; sun.shadow.radius=3; sun.target.position.set(0,0,-L/2);
scene.add(sun,sun.target);
const ground=new THREE.Mesh(new THREE.PlaneGeometry(20000,20000),new THREE.ShadowMaterial({opacity:0.45}));
ground.rotation.x=-Math.PI/2; ground.receiveShadow=true; scene.add(ground);

/* ---------- texturas ---------- */
function canvasTex(w,h,draw,rx,ry){
  const c=document.createElement('canvas'); c.width=w; c.height=h;
  draw(c.getContext('2d'),w,h);
  const t=new THREE.CanvasTexture(c); t.wrapS=t.wrapT=THREE.RepeatWrapping;
  t.repeat.set(rx,ry); t.anisotropy=MAXANI; t.encoding=THREE.sRGBEncoding; return t;
}
function rnd(s){return()=>{s=(s*16807)%2147483647;return(s-1)/2147483646}}
/* poliuretano: tono ocre claro, grano fino, vetas horizontales suaves y poros */
function foamDraw(g,w,h,bump){
  const r=rnd(7);
  g.fillStyle=bump?"#808080":"#d4b47c";g.fillRect(0,0,w,h);
  for(let i=0;i<60;i++){const y=r()*h,hh=4+r()*30;g.fillStyle=bump?`rgba(${r()>.5?255:0},${r()>.5?255:0},${r()>.5?255:0},.03)`:(r()>.5?`rgba(255,240,205,${.05+.07*r()})`:`rgba(150,110,55,${.04+.06*r()})`);g.fillRect(0,y,w,hh);}
  for(let i=0;i<26000;i++){const v=r(),x=r()*w,y=r()*h,s=.6+r()*1.8;
    g.fillStyle=bump?(v<.5?`rgba(255,255,255,${.35*r()})`:`rgba(0,0,0,${.35*r()})`):(v<.5?`rgba(255,246,220,${.22*r()})`:`rgba(120,85,40,${.2*r()})`);g.fillRect(x,y,s*(1+r()*2),s);}
  for(let i=0;i<420;i++){g.fillStyle=bump?`rgba(0,0,0,${.5+.4*r()})`:`rgba(105,75,35,${.35+.35*r()})`;g.beginPath();g.ellipse(r()*w,r()*h,.6+r()*1.6,.5+r()*1.1,0,0,7);g.fill()}
}
const foamTex=canvasTex(1024,1024,(g,w,h)=>foamDraw(g,w,h,false),1/90,1/90);
const foamBump=canvasTex(1024,1024,(g,w,h)=>foamDraw(g,w,h,true),1/90,1/90); foamBump.encoding=THREE.LinearEncoding;
/* galvanizado: flor de zinc (cristales irregulares en distintos tonos de gris) */
const galvTex=canvasTex(1024,1024,(g,w,h)=>{
  g.fillStyle="#b9bec3";g.fillRect(0,0,w,h);const r=rnd(5);
  for(let i=0;i<1400;i++){
    const x=r()*w,y=r()*h,s=10+r()*42,v=Math.round(140+r()*95);
    g.fillStyle=`rgba(${v},${v+3},${v+7},.6)`;g.beginPath();
    const n=5+Math.floor(r()*3);
    for(let k=0;k<n;k++){const a=k/n*6.283+r()*.6,rr=s*(.55+r()*.6),px=x+Math.cos(a)*rr,py=y+Math.sin(a)*rr;k?g.lineTo(px,py):g.moveTo(px,py)}
    g.closePath();g.fill();
  }
  for(let i=0;i<14000;i++){g.fillStyle=`rgba(255,255,255,${.07*r()})`;g.fillRect(r()*w,r()*h,1,1)}
},1/320,1/320);
/* acero inoxidable: liso con líneas finas de satinado a lo largo del panel (según las muestras 304 y 430) */
function brushed(base,lines,alpha,maxW,patches,seed){
  return canvasTex(1024,1024,(g,w,h)=>{
    g.fillStyle=base;g.fillRect(0,0,w,h);const r=rnd(seed);
    for(let i=0;i<patches;i++){const y=r()*h,hh=60+r()*220,gr=g.createLinearGradient(0,y,0,y+hh);
