}

/* ---------- PANEL DE PARED (machihembrado) ----------
   Hembra (izquierda): hombro en cada cara, dedo relleno de poliuretano que sobresale, centro rehundido.
   Macho (derecha): hombro en cada cara, ranura en U hacia adentro, lengüeta central ancha que sobresale. */
/* Medidas del machihembrado (fracciones del espesor T), según el corte de referencia:
   JA/JB: la ranura y el dedo van entre JA y JB desde cada cara; JL: fondo de la ranura medido desde la cara;
   JC: cuánto se rehunde el centro del macho (y sobresale el de la hembra); JCH: chaflán de las caras. */
const JA=.18, JB=.33, JL=.36, JC=.13, JCH=.045, GAP=2*SHEET+.2;
/* Radio de las esquinas de las caras (narices redondeadas, como en la foto real). */
/* Producción: el perfil del encaje (curvas, dedos y ranuras) es siempre el mismo, tomado del panel de 40 mm.
   Al aumentar el espesor solo crece el tramo central entre los dos dedos. */
const JT=40;
const jface=()=>Math.min(6,.11*JT);
/* Redondea las esquinas de un perfil: R[i] es el radio (mm) en el punto i; se limita para no pisar las esquinas vecinas. */
function fillet(p,R){
  const o=[];
  for(let i=0;i<p.length;i++){
    const r=R[i]||0;
    if(!r||i===0||i===p.length-1){o.push(p[i]);continue}
    const A=p[i-1],B=p[i],C=p[i+1];
    const l1=Math.hypot(A[0]-B[0],A[1]-B[1]),l2=Math.hypot(C[0]-B[0],C[1]-B[1]);
    const rr=Math.min(r,.48*l1,.48*l2);
    const P=[B[0]+(A[0]-B[0])/l1*rr,B[1]+(A[1]-B[1])/l1*rr],Q=[B[0]+(C[0]-B[0])/l2*rr,B[1]+(C[1]-B[1])/l2*rr];
    for(let k=0;k<=8;k++){const t=k/8,m=1-t;o.push([m*m*P[0]+2*m*t*B[0]+t*t*Q[0],m*m*P[1]+2*m*t*B[1]+t*t*Q[1]]);}
  }
  return o;
}
/* Profundidad real del encaje: 15 mm (no crece con el espesor del panel). */
const JMAX=15;
const jL=()=>Math.min(JMAX,JL*JT), jc=()=>jL()*JC/JL, jch=()=>Math.min(2.2,JCH*T), jrr=()=>Math.min(1.5,.03*T);
function femaleTop(){
  const s=JT,S=SHEET,a=JA*s,b=JB*s,Lf=jL()+.2,xc=-jc()-2*S;
  const p=[[xc,T-b+2*S],[-Lf,T-b+2*S],[-Lf,T-a-2*S],[0,T-a-2*S],[0,T]];
  return fillet(p,[0,4,4,3,0]);
}
function maleTop(){
  const s=JT,a=JA*s,b=JB*s,L=jL(),c=jc();
  const p=[[PW,T],[PW,T-a],[PW-L,T-a],[PW-L,T-b],[PW-c,T-b]];
  return fillet(p,[0,3,4,4,0]);
}
function panelTopRun(finish){
  const p=[[8,T]];
  if(FIN[finish].tab){
    const n=11;
    for(let k=1;k<n;k++){const g=PW*k/n; if(g>PW-30)break;
      p.push([g-9,T],[g-3,T-2],[g+3,T-2],[g+9,T]);}
  }
  p.push([PW-8,T]);
  return p;
}
/* ---------- PRFV: no se puede doblar → sin machihembrado ----------
   Bordes rectos; la lámina de PRFV sigue recta y sobresale OV mm. Dos paneles se unen con el
   Perfil Barra División PVC (perfil H): las láminas de PRFV entran en las ranuras del perfil. */
const OV=4, HW=2, HG=2*OV+HW;                 /* sobresale de lámina, alma del perfil, separación entre núcleos */
const straight=()=>product==="panel"&&faces().some(F=>F.f==='prfv');
const prfvBoth=()=>product==="panel"&&faces().every(F=>F.f==='prfv');
const hMat=new THREE.MeshStandardMaterial({color:0xf5f5f3,roughness:.33,metalness:0});
/* Los núcleos llegan hasta la línea de unión (xL/xR): al encajar quedan bien pegaditos.
   Bajo la lámina de PRFV, el ala inferior del perfil H se mete en la espuma (rebaje fino en el borde). */
const HN=OV+HW/2-.4+.1, HD=1.3;              /* ancho y profundidad del rebaje donde entra el ala */
function facePaths(F){
  const xL=-HG/2, xR=PW+HG/2;
  if(F.f==='prfv')return{foam:[[xL,T-HD],[xL+HN,T-HD],[xL+HN,T],[xR-HN,T],[xR-HN,T-HD],[xR,T-HD]],sheet:[[-OV,T],[PW+OV,T]]};
  /* lámina metálica: recta y doblada en los bordes */
  const pts=[[xL,T-8],[xL,T],...panelTopRun(F.f),[xR,T],[xR,T-8]],R=[];R[1]=3;R[pts.length-2]=3;
  const p=fillet(pts,R);return{foam:p,sheet:p};
}
let JX1=0, JJ=0;   /* posición del segundo panel ya unido y de la línea de unión (perfil H) */
/* Una cara PRFV y la otra metálica: la cara metálica conserva su mitad del machihembrado
   (dedo en la hembra, ranura en el macho); del lado del PRFV el borde es recto y lleva perfil H. */
function buildPanelMixed(group){
  const fs=faces(), ip=fs[0].f==='prfv'?0:1, Fp=fs[ip], Fm=fs[1-ip];
  const fem=femaleTop(), male=maleTop(), run=panelTopRun(Fm.f);
  const R=Object.assign([],{[fem.length-1]:jface(),[fem.length+run.length]:jface()});
  const up=fillet(fem.concat(run,male),R);
