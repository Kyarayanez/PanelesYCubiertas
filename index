  const seam=new THREE.Mesh(new THREE.BoxGeometry(1.6,1.7,L),new THREE.MeshStandardMaterial({color:0x3b3f44,roughness:.8}));
  seam.position.set(-2*RTB-1.2-cx,T+S+.4,-L/2);group.add(seam);
