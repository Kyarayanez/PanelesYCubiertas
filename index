  /* las láminas no reciben sombra propia: así el dedo y la ranura de abajo se ven igual de limpios que los de arriba */
  const s1=extrude(strip(up,F1.c),sheetMat(F1.f),PW/2), s2=extrude(strip(mirror(lo),-F2.c),sheetMat(F2.f),PW/2);
  s1.receiveShadow=false; s2.receiveShadow=false;
  group.add(s1); group.add(s2);
}

/* ---------- CUBIERTA (traslape) ----------
   Según la foto de dos cubiertas unidas:
   · Lámina superior trapezoidal: 3 grecas cada 333 mm con 2 nervios pequeños en cada valle.
   · Extremo derecho (recibe el traslape): la última greca va llena de poliuretano; su flanco exterior es inclinado
     hasta el nivel del valle y desde ahí el lateral baja recto hasta abajo. La lámina superior termina en la
     esquina de la cima. Cara lateral con cinta MAFRICO. Abajo, la lámina hace un pequeño doblez en la esquina y
     sale como pestaña plana que pasa por debajo del vecino.
   · Extremo izquierdo (hace el traslape): el poliuretano termina en una cara recta y la lámina superior sigue sola
     como ala: sube por el flanco inclinado de la greca del vecino y dobla un poco sobre su cima.
   · La línea oscura marca el borde del ala: es la unión visible entre cubiertas. */
const RTB=40, RTT=12.5, RLIP=7;   /* medio ancho de greca en base y cima; doblez del ala sobre la cima */
/* Encaje inferior de cubierta (medida fija, no depende del espesor): una sola ranura/dedo muy fino cerca de la cara inferior */
const RJA=3, RJB=9, RJL=10;      /* la ranura va de RJA a RJB mm sobre la cara inferior y entra RJL mm */
function roofTopSheet(){
  const t=T,h=RH,p=RW/3,S=SHEET,fx=RTB-RTT;        /* fx: avance horizontal del flanco */
  /* ala: sube por el flanco de la greca del vecino (que termina en x=0) y dobla sobre su cima */
  /* el ala va un espesor de lámina por encima de la lámina que cubre la greca del vecino */
  /* el ala forma la onda completa: sube por un flanco, cruza la cima y baja por el otro hasta el valle del vecino */
  const pts=[[-2*RTB-.6,t+S],[-RTB-RTT-.4,t+h+S],[-fx+.4,t+h+S],[1,t+S],[2,t]];
  for(let c=2;c>=0;c--){
    const cx=RW-RTB-c*p;                           /* centros de greca; la última queda pegada al borde derecho */
    const v0=cx-p+RTB, v1=cx-RTB;                   /* valle antes de esta greca */
    for(const f of [1/3,2/3]){const rx=v0+(v1-v0)*f;if(rx-14>2)pts.push([rx-14,t],[rx-8,t+5],[rx+8,t+5],[rx+14,t]);}
    pts.push([cx-RTB,t],[cx-RTT,t+h],[cx+RTT,t+h]);
    if(c>0)pts.push([cx+RTB,t]);
  }
  pts.push([RW,t],[RW,t-1.5]);                       /* la lámina cubre todo el flanco exterior hasta donde empieza la cinta */
  return pts;
}
function roofJoint(){
  const S=SHEET,Lf=RJL-2*S-.2;
  /* hembra en el extremo izquierdo (dedo), macho en el derecho (ranura en U); esquinas redondeadas */
  const fem=fillet([[0,T],[0,RJB-2*S],[-Lf,RJB-2*S],[-Lf,RJA+2*S],[0,RJA+2*S],[0,0]],[0,.8,9,9,.8,0]);   /* punta del dedo redonda (U) */
  const male=fillet([[RW,T],[RW,RJB],[RW-RJL,RJB],[RW-RJL,RJA],[RW,RJA],[RW,0]],[0,.8,9,9,.8,0]);   /* fondo de la ranura redondo (U) */
  return{fem,male};
}
function buildRoof(group){
  const cx=RW/2, S=SHEET, fx=RTB-RTT;
  const tp=roofTopSheet(), {fem,male}=roofJoint();
  /* poliuretano: lado izquierdo con el dedo del encaje; a la derecha, flanco inclinado de la greca llena, lateral recto y ranura */
  const body=tp.filter(([x,y])=>x>=1.5&&x<RW-1);
  const [F1,F2]=faces();
  /* cara inferior recta con efecto tableteado (líneas suaves a lo largo) */
  const grooves=[];for(let k=1;k<11;k++){const g=RW*k/11;grooves.push([g-9,0],[g-3,2],[g+3,2],[g+9,0]);}
  const foam=[...fem.slice().reverse(),...body,...male,...grooves.slice().reverse()];
  group.add(extrude(foam,foamMat,cx));
  group.add(extrude(strip(tp,F1.c),sheetMat(F1.f),cx));
  /* lámina inferior: envuelve el dedo, recorre la cara inferior tableteada y forra la ranura */
  const fi=fem.findIndex(([x,y])=>x===0&&y===RJB-2*S);
  const bot=[...fem.slice(fi>=0?fi:1),...grooves,[RW,0],...male.slice().reverse().slice(1,male.length-1)];
  group.add(extrude(strip(bot,-F2.c),sheetMat(F2.f),cx));
